# Development defaults. Copy to .env at the repository root.
# These values are for local development only.

POSTGRES_USER=vigie
POSTGRES_PASSWORD=vigie
POSTGRES_DB=vigie
# Host port. 5433 avoids a local PostgreSQL that already owns 5432.
# Inside the container, PostgreSQL still listens on 5432.
POSTGRES_PORT=5433

# Used by FastAPI on the host. The hostname is localhost because PostgreSQL
# publishes its port from Docker.
DATABASE_URL=postgresql+psycopg://vigie:vigie@localhost:5433/vigie
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Used by pytest. Separate database so tests do not write into development data.
TEST_DATABASE_URL=postgresql+psycopg://vigie:vigie@localhost:5433/vigie_test

API_HOST=0.0.0.0
API_PORT=8000

# Local heuristic mode. No external credentials.
AI_PROVIDER=heuristic

# Demo reset and run are available only when this is true.
# Leave it false outside a local demonstration.
VIGIE_DEMO_MODE=true

# NVIDIA mode. Set AI_PROVIDER=nvidia and fill the three values for the
# NVIDIA environment you are using. The model name and base URL are not
# assumed. Leave the key blank in this example. Do not commit a real key.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# NVIDIA_BASE_URL=
# NVIDIA_TIMEOUT_SECONDS=30

# Minutes without a business reply before an UNANSWERED_REQUEST event becomes a signal.
UNANSWERED_REQUEST_THRESHOLD_MINUTES=60

# Public web origin used after an OAuth callback and for session cookies.
# No secrets belong here.
PUBLIC_WEB_URL=http://localhost:3000

# Fernet key for integration tokens at rest. Generate one locally and do not
# commit it. The API refuses to store provider tokens until this is set.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Provider credentials. Leave these unset until a Meta, Google, or Microsoft
# app exists. The API starts without them. Real channels then show
# "Not configured". Do not commit real values.
# META_APP_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_ACCESS_TOKEN=
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_PHONE_NUMBER_ID=
# Required for Gmail OAuth. Leave unset until a Google Cloud OAuth client exists.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Required for Gmail Pub/Sub push. Leave unset to keep manual sync only.
# The API starts without these. Real-time listening then shows "Not configured".
# GMAIL_PUBSUB_TOPIC=projects/PROJECT_ID/topics/TOPIC
# GMAIL_PUBSUB_AUDIENCE=https://api.example.com/api/integrations/gmail/pubsub
# GMAIL_PUBSUB_SERVICE_ACCOUNT=pubsub-push@PROJECT_ID.iam.gserviceaccount.com
# How early a daily scheduler renews a watch, in hours. Default 24.
# GMAIL_WATCH_RENEW_WITHIN_HOURS=24
# Required for Microsoft 365 OAuth. Leave unset until an Entra app registration exists.
# MICROSOFT_TENANT_ID=common allows any organizational directory when the app is multi-tenant.
# Set a directory ID instead to allow only that tenant. Leave the redirect empty to derive it.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=

# Server-side Next.js rewrite target. The browser never calls this URL.
API_INTERNAL_URL=http://127.0.0.1:8000

WEB_PORT=3000

# First production deployment uses the Vercel URL and the Render URL.
# A custom domain is a later environment change, not a code change.
# Do not commit real secrets. Session cookies do not use SESSION_SECRET:
# each cookie holds a random token, and the database stores only its SHA-256 hash.
#
# APP_ENV=production
# VIGIE_DEMO_MODE=false
# AI_PROVIDER=heuristic
# PORT is provided by Render. Do not hard-code it.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/vigie?sslmode=require
# PUBLIC_WEB_URL=https://<vercel-host>
# CORS_ORIGINS=
# API_PUBLIC_URL=https://<render-host>
# API_INTERNAL_URL=https://<render-host>
# CREDENTIAL_ENCRYPTION_KEY=
# Leave the callback variables empty to derive them from API_PUBLIC_URL.
# GOOGLE_REDIRECT_URI=
# MICROSOFT_REDIRECT_URI=
# GMAIL_PUBSUB_AUDIENCE=
