# Development defaults. Copy to .env at the repository root.
# These values are for local development only.

POSTGRES_USER=vigie
POSTGRES_PASSWORD=vigie
POSTGRES_DB=vigie
# Host port. 5433 avoids a local PostgreSQL that already owns 5432.
# Inside the container, PostgreSQL still listens on 5432.
POSTGRES_PORT=5433

# Used by FastAPI on the host. The hostname is localhost because PostgreSQL
# publishes its port from Docker.
DATABASE_URL=postgresql+psycopg://vigie:vigie@localhost:5433/vigie
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Used by pytest. Separate database so tests do not write into development data.
TEST_DATABASE_URL=postgresql+psycopg://vigie:vigie@localhost:5433/vigie_test

API_HOST=0.0.0.0
API_PORT=8000

# Local heuristic mode. No external credentials.
AI_PROVIDER=heuristic

# Demo reset and run are available only when this is true.
# Leave it false outside a local demonstration.
VIGIE_DEMO_MODE=true

# NVIDIA mode. Set AI_PROVIDER=nvidia and fill the three values for the
# NVIDIA environment you are using. The model name and base URL are not
# assumed. Leave the key blank in this example. Do not commit a real key.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=
# NVIDIA_BASE_URL=
# NVIDIA_TIMEOUT_SECONDS=30

# Minutes without a business reply before an UNANSWERED_REQUEST event becomes a signal.
UNANSWERED_REQUEST_THRESHOLD_MINUTES=60

# Server-side Next.js rewrite target. The browser never calls this URL.
API_INTERNAL_URL=http://127.0.0.1:8000

WEB_PORT=3000
